{
    "name": "task-list/laravel-api",
    "type": "project",
    "description": "Task List Laravel API Application with DDD and CQRS",
    "keywords": [
        "laravel",
        "api",
        "jwt",
        "ddd",
        "cqrs",
        "swagger"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "darkaonline/l5-swagger": "^8.6",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "lcobucci/jwt": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mezzio/mezzio-problem-details": "^1.0",
        "namshi/jose": "^7.2",
        "php-amqplib/php-amqplib": "^3.7",
        "predis/predis": "^2.0",
        "sentry/sentry-laravel": "^4.20",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-fractal": "^6.0",
        "spatie/laravel-permission": "^6.0",
        "tymon/jwt-auth": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4",
        "barryvdh/laravel-ide-helper": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Factories\\": "database/factories/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-fix-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "phpstan": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
